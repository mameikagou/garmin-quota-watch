{
  "name": "garmin-quota-watch",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "QUOTA_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }],
  "durable_objects": {
    "bindings": [{ "name": "REFRESH_COORDINATOR", "class_name": "RefreshCoordinator" }]
  },
  "exports": {
    "RefreshCoordinator": { "type": "durable-object", "storage": "sqlite" }
  }
}
